<Window x:Class="DevLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DevLauncher.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        Title="Dev Launcher"
        Height="720" Width="920"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBgBrush}"
        FontFamily="Segoe UI">

    <DockPanel LastChildFill="True">

        <!-- ═══════════════════ HEADER ═══════════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBgBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="⚡ Dev Launcher"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentBlueBrush}"/>
                    <TextBlock Text="Lance ton environnement de développement en un clic"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Service indicators + settings button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding ServiceIndicators}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ServiceIndicatorViewModel}">
                                <Border CornerRadius="12" Padding="10,5" Margin="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#3A1A24"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="#1A3A1A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource AccentRedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ServiceName}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Separator -->
                    <Border Width="1" Background="#444466" Margin="8,0"/>

                    <!-- Settings button -->
                    <Button Content="⚙️"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="14" Padding="8,5"
                            ToolTip="Paramètres"
                            Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════ FOOTER / BUTTONS ═══════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBgBrush}"
                Padding="24,14" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Row 1 : Profiles ── -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Profil :"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <!-- Profiles dropdown -->
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding ProfileNames}"
                              SelectedItem="{Binding ActiveProfileName, Mode=TwoWay}"
                              IsEnabled="{Binding HasProject}"/>

                    <!-- Profile actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="💾 Sauvegarder"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11" Padding="10,5" Margin="8,0,0,0"
                                ToolTip="Enregistrer les options dans le profil"
                                Command="{Binding SaveProfileCommand}"/>
                        <Button Content="➕"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11" Padding="8,5" Margin="6,0,0,0"
                                ToolTip="Nouveau profil à partir des options actuelles"
                                Command="{Binding CreateProfileCommand}"/>
                        <Button Content="✏️"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11" Padding="8,5" Margin="6,0,0,0"
                                ToolTip="Renommer le profil"
                                Command="{Binding RenameProfileCommand}"/>
                        <Button Content="🗑️"
                                Style="{StaticResource DangerButton}"
                                FontSize="11" Padding="8,5" Margin="6,0,0,0"
                                ToolTip="Supprimer le profil"
                                Command="{Binding DeleteProfileCommand}"/>
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ── Row 2 : Action buttons ── -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stop all button -->
                    <Button Grid.Column="0"
                            HorizontalAlignment="Left"
                            Content="⏹ Tout arrêter"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding StopAllCommand}"/>

                    <!-- Split launch button : the profiles menu appears when the project has several profiles -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="LaunchButton"
                                Content="{Binding LaunchButtonLabel}"
                                Command="{Binding LaunchCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SplitSuccessButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSeveralProfiles}" Value="True">
                                            <Setter Property="Tag" Value="8,0,0,8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Width="1"
                                Background="#2ABB77"
                                Visibility="{Binding HasSeveralProfiles, Converter={StaticResource BooleanToVisibility}}"/>

                        <ToggleButton Content="▾"
                                      Tag="0,8,8,0"
                                      Padding="10,10"
                                      IsChecked="{Binding IsLaunchMenuOpen, Mode=TwoWay}"
                                      IsEnabled="{Binding IsIdle}"
                                      Visibility="{Binding HasSeveralProfiles, Converter={StaticResource BooleanToVisibility}}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource SplitSuccessButton}">
                                    <Style.Triggers>
                                        <!-- The popup closes itself on the click : the toggle must not reopen it -->
                                        <DataTrigger Binding="{Binding IsLaunchMenuOpen}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <!-- Profiles launch menu -->
                        <Popup PlacementTarget="{Binding ElementName=LaunchButton}"
                               Placement="Top"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               IsOpen="{Binding IsLaunchMenuOpen, Mode=TwoWay}">
                            <Border Background="#2A2A3E"
                                    BorderBrush="#444466"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    MinWidth="220">
                                <ItemsControl ItemsSource="{Binding ProfileNames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Style="{StaticResource PopupProfileButton}"
                                                    Command="{Binding DataContext.LaunchProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════ CENTRAL AREA (content + splitter + logs) ═══════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="150" MinHeight="60" MaxHeight="400"/>
            </Grid.RowDefinitions>

            <!-- ── Main content ── -->
            <Grid Grid.Row="0" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left column : projects list ── -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title + refresh button -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📁 Projets"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Grid.Column="1" Content="↻ Rafraîchir"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="11" Padding="10,5"
                                    Command="{Binding RefreshProjectsCommand}"/>
                        </Grid>

                        <!-- Search bar -->
                        <Border Grid.Row="1"
                                Background="#1A1A2E" CornerRadius="6"
                                Margin="0,0,0,10" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" VerticalAlignment="Center"
                                           Margin="0,0,8,0" FontSize="13"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource AccentBlueBrush}"
                                         FontSize="13" Padding="0,8">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Resources>
                                                <VisualBrush x:Key="HintBrush" TileMode="None"
                                                             Opacity="0.4" Stretch="None"
                                                             AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Rechercher un projet..."
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- Projects list, grouped : recent projects, then all projects -->
                        <ListBox x:Name="ProjectListBox"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding ProjectsView}"
                                 SelectedItem="{Binding SelectedProjectEntry, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 ItemContainerStyle="{StaticResource ProjectListItem}"
                                 SelectionChanged="ProjectListBox_SelectionChanged">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="4,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>

                        <!-- Current project path -->
                        <Border Grid.Row="3"
                                Background="#1A1A2E" CornerRadius="6"
                                Padding="10,6" Margin="0,10,0,0">
                            <TextBlock Text="{Binding CurrentProjectDisplayPath}"
                                       FontSize="11" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Right column : options, built from the tool catalog ── -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Card : Project type -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="🏗️ Type de projet" Style="{StaticResource CardTitle}"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding ProjectTypeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="ProjectType"
                                          SelectedValue="{Binding SelectedProjectType, Mode=TwoWay}"
                                          IsEnabled="{Binding HasProject}"/>
                                <Border Background="#2A4A2A" CornerRadius="6"
                                        Padding="8,5" Margin="0,8,0,0"
                                        Visibility="{Binding IsSymfonyDetected, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Text="✅ Symfony détecté automatiquement"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentGreenBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tool cards -->
                        <ItemsControl ItemsSource="{Binding ToolCategoryViewModels}" IsEnabled="{Binding HasProject}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ToolCategoryViewModel}">
                                    <Border Style="{StaticResource CardBorder}"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                            <ItemsControl ItemsSource="{Binding Tools}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewModels:ToolViewModel}">
                                                        <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibility}}">
                                                            <!-- Exclusive categories use radio buttons, the others check boxes -->
                                                            <CheckBox Content="{Binding Label}"
                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernCheckBox}"
                                                                      Visibility="{Binding IsExclusive, Converter={StaticResource InverseBooleanToVisibility}}"/>
                                                            <RadioButton Content="{Binding Label}"
                                                                         IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                         Style="{StaticResource ModernRadioButton}"
                                                                         Visibility="{Binding IsExclusive, Converter={StaticResource BooleanToVisibility}}"/>
                                                            <!-- Options of the enabled tool -->
                                                            <ItemsControl ItemsSource="{Binding Options}"
                                                                          Margin="20,0,0,4"
                                                                          Visibility="{Binding ShowOptions, Converter={StaticResource BooleanToVisibility}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type viewModels:ToolOptionViewModel}">
                                                                        <Border Background="#1A1A2E" CornerRadius="6" Padding="10,8" Margin="0,2">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Label}"
                                                                                           FontSize="11"
                                                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                                                           Margin="0,0,0,6"/>
                                                                                <ComboBox Style="{StaticResource DarkComboBox}"
                                                                                          ItemsSource="{Binding Choices}"
                                                                                          DisplayMemberPath="Label"
                                                                                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                                                          Visibility="{Binding IsSingleChoice, Converter={StaticResource BooleanToVisibility}}"/>
                                                                                <ItemsControl ItemsSource="{Binding Choices}"
                                                                                              Visibility="{Binding IsMultipleChoice, Converter={StaticResource BooleanToVisibility}}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="{x:Type viewModels:ToolOptionChoiceViewModel}">
                                                                                            <CheckBox Content="{Binding Label}"
                                                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                                      Style="{StaticResource ModernCheckBox}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <TextBlock Text="Aucun choix disponible (vérifie les paramètres)"
                                                                                           FontSize="11" TextWrapping="Wrap"
                                                                                           Foreground="{StaticResource AccentRedBrush}"
                                                                                           Visibility="{Binding HasNoChoices, Converter={StaticResource BooleanToVisibility}}"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── Splitter ── -->
            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#333355"
                          Margin="16,0,16,0"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeNS"/>

            <!-- ── Log area ── -->
            <Border Grid.Row="2" Margin="16,0,16,8"
                    Background="{StaticResource CardBgBrush}"
                    CornerRadius="12" Padding="12">
                <DockPanel>
                    <!-- Fixed header with the copy and clear buttons -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📋 Journal de lancement"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Grid.Column="1" Content="Copier"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="10" Padding="8,3" Margin="0,0,6,0"
                                Command="{Binding CopyLogCommand}"/>
                        <Button Grid.Column="2" Content="Effacer"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="10" Padding="8,3"
                                Command="{Binding ClearLogCommand}"/>
                    </Grid>

                    <!-- Scrollable log lines -->
                    <ListBox x:Name="LogListBox"
                             ItemsSource="{Binding LogEntries}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}"
                                           FontFamily="Consolas" FontSize="11"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

        </Grid>

    </DockPanel>
</Window>
