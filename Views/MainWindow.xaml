<Window x:Class="DevLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DevLauncher.ViewModels"
        xmlns:behaviors="clr-namespace:DevLauncher.Views.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        Title="Dev Launcher"
        Height="936" Width="1196"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI">

    <Window.InputBindings>
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Quick actions of a project, opened by a right click on any project list -->
        <ContextMenu x:Key="ProjectContextMenu" x:Shared="False">
            <MenuItem Header="★ Épingler / retirer des favoris"
                      Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <Separator/>
            <MenuItem Header="📂 Ouvrir dans l'Explorateur"
                      Command="{Binding PlacementTarget.Tag.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="📋 Copier le chemin"
                      Command="{Binding PlacementTarget.Tag.CopyProjectPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="🌍 Ouvrir l'URL locale"
                      Command="{Binding PlacementTarget.Tag.OpenLocalUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="🧠 Copier le contexte pour l'IA"
                      Command="{Binding PlacementTarget.Tag.CopyProjectContextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="🔗 Copier le lien de lancement (devlauncher://)"
                      Command="{Binding PlacementTarget.Tag.CopyLaunchLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
        </ContextMenu>

        <!-- Project item carrying the main view model in its Tag, for the context menu commands -->
        <Style x:Key="ProjectListItemWithMenu" TargetType="ListBoxItem" BasedOn="{StaticResource ProjectListItem}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
            <Setter Property="ContextMenu" Value="{StaticResource ProjectContextMenu}"/>
        </Style>

        <!-- Small action button of the project bar -->
        <Style x:Key="QuickActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding"  Value="8,4"/>
            <Setter Property="Margin"   Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ═══════════════════ HEADER ═══════════════════ -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBgBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="⚡ Dev Launcher"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlueBrush}"/>
                    <TextBlock Text="Lance ton environnement de développement en un clic"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Service indicators + settings button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding ServiceIndicators}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ServiceIndicatorViewModel}">
                                <Border CornerRadius="12" Padding="10,5" Margin="4,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ServiceStoppedBgBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ServiceRunningBgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentRedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding ServiceName}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Separator -->
                    <Border Width="1" Background="{DynamicResource BorderLineBrush}" Margin="8,0"/>

                    <!-- Command palette button -->
                    <Button Content="⚡"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="14" Padding="8,5" Margin="0,0,6,0"
                            ToolTip="Palette de commandes (Ctrl+K)"
                            AutomationProperties.Name="Palette de commandes"
                            Command="{Binding OpenCommandPaletteCommand}"/>

                    <!-- Statistics button -->
                    <Button Content="📊"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="14" Padding="8,5" Margin="0,0,6,0"
                            ToolTip="Statistiques de lancement"
                            AutomationProperties.Name="Statistiques"
                            Command="{Binding ShowStatisticsCommand}"/>

                    <!-- Settings button -->
                    <Button Content="⚙️"
                            Style="{StaticResource PrimaryButton}"
                            FontSize="14" Padding="8,5"
                            ToolTip="Paramètres"
                            Command="{Binding OpenSettingsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════ FOOTER / BUTTONS ═══════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource CardBgBrush}"
                Padding="24,14" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Row 1 : Profiles ── -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Profil :"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <!-- Profiles dropdown -->
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding ProfileNames}"
                              SelectedItem="{Binding ActiveProfileName, Mode=TwoWay}"
                              IsEnabled="{Binding HasProject}"/>

                    <!-- Profile actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="💾 Sauvegarder"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11" Padding="10,5" Margin="8,0,0,0"
                                ToolTip="Enregistrer les options dans le profil"
                                Command="{Binding SaveProfileCommand}"/>
                        <Button Content="➕"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11" Padding="8,5" Margin="6,0,0,0"
                                ToolTip="Nouveau profil à partir des options actuelles"
                                Command="{Binding CreateProfileCommand}"/>
                        <Button Content="✏️"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11" Padding="8,5" Margin="6,0,0,0"
                                ToolTip="Renommer le profil"
                                Command="{Binding RenameProfileCommand}"/>
                        <Button Content="🗑️"
                                Style="{StaticResource DangerButton}"
                                FontSize="11" Padding="8,5" Margin="6,0,0,0"
                                ToolTip="Supprimer le profil"
                                Command="{Binding DeleteProfileCommand}"/>
                        <Button Content="{Binding ProfileSharingLabel}"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11" Padding="8,5" Margin="6,0,0,0"
                                ToolTip="{Binding ProfileSharingToolTip}"
                                AutomationProperties.Name="Partage des profils avec le projet"
                                Command="{Binding ToggleProfileSharingCommand}"/>
                    </StackPanel>

                    <!-- Status -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ── Row 2 : Action buttons ── -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stop all button -->
                    <Button Grid.Column="0"
                            HorizontalAlignment="Left"
                            Content="⏹ Tout arrêter"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding StopAllCommand}"/>

                    <!-- Launch progress, step by step -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="24,0"
                                Visibility="{Binding IsLaunchInProgress, Converter={StaticResource BooleanToVisibility}}">
                        <TextBlock Text="{Binding LaunchStepText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4"/>
                        <ProgressBar Height="6"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding LaunchProgressValue, Mode=OneWay}"
                                     Background="{DynamicResource InputBgBrush}"
                                     Foreground="{DynamicResource AccentGreenBrush}"
                                     BorderThickness="0"
                                     AutomationProperties.Name="Progression du lancement"/>
                    </StackPanel>

                    <!-- Split launch button : the profiles menu appears when the project has several profiles -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="LaunchButton"
                                Content="{Binding LaunchButtonLabel}"
                                Command="{Binding LaunchCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SplitSuccessButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSeveralProfiles}" Value="True">
                                            <Setter Property="Tag" Value="8,0,0,8"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Border Width="1"
                                Background="{DynamicResource SuccessPressedBrush}"
                                Visibility="{Binding HasSeveralProfiles, Converter={StaticResource BooleanToVisibility}}"/>

                        <ToggleButton Content="▾"
                                      Tag="0,8,8,0"
                                      Padding="10,10"
                                      IsChecked="{Binding IsLaunchMenuOpen, Mode=TwoWay}"
                                      IsEnabled="{Binding IsIdle}"
                                      Visibility="{Binding HasSeveralProfiles, Converter={StaticResource BooleanToVisibility}}">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource SplitSuccessButton}">
                                    <Style.Triggers>
                                        <!-- The popup closes itself on the click : the toggle must not reopen it -->
                                        <DataTrigger Binding="{Binding IsLaunchMenuOpen}" Value="True">
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <!-- Profiles launch menu -->
                        <Popup PlacementTarget="{Binding ElementName=LaunchButton}"
                               Placement="Top"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               IsOpen="{Binding IsLaunchMenuOpen, Mode=TwoWay}">
                            <Border Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource BorderLineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    MinWidth="220">
                                <ItemsControl ItemsSource="{Binding ProfileNames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}"
                                                    Style="{StaticResource PopupProfileButton}"
                                                    Command="{Binding DataContext.LaunchProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════ CENTRAL AREA (content + splitter + logs) ═══════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="200" MinHeight="80" MaxHeight="500"/>
            </Grid.RowDefinitions>

            <!-- ── Main content ── -->
            <Grid Grid.Row="0" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left column : projects list ── -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Rows : title, search, pinned and recent blocks, list title, list, project bar -->

                        <!-- Title + refresh button -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📁 Projets"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="➕ Ajouter"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="11" Padding="10,5" Margin="0,0,6,0"
                                        ToolTip="Ajouter un projet situé dans n'importe quel dossier"
                                        Command="{Binding AddProjectCommand}"/>
                                <Button Content="↻ Rafraîchir"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="11" Padding="10,5"
                                        Command="{Binding RefreshProjectsCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Search bar -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource InputBgBrush}" CornerRadius="6"
                                Margin="0,0,0,10" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" VerticalAlignment="Center"
                                           Margin="0,0,8,0" FontSize="13"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Rechercher un projet"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentBlueBrush}"
                                         FontSize="13" Padding="0,8">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Resources>
                                                <VisualBrush x:Key="HintBrush" TileMode="None"
                                                             Opacity="0.4" Stretch="None"
                                                             AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Rechercher un projet..."
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2">
                            <!-- Favorite projects : pinned by the user -->
                            <Border Background="{DynamicResource FavoriteBgBrush}"
                                    BorderBrush="{DynamicResource FavoriteBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Margin="0,0,0,8"
                                    Visibility="{Binding HasFavoriteProjects, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="★ Favoris"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FavoriteBrush}"
                                               Margin="4,0,0,4"/>
                                    <ListBox Background="Transparent"
                                             BorderThickness="0"
                                             AutomationProperties.Name="Projets favoris"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding FavoriteProjects}"
                                             SelectedItem="{Binding SelectedFavoriteProject, Mode=TwoWay}"
                                             ItemContainerStyle="{StaticResource ProjectListItemWithMenu}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, StringFormat='★  {0}'}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <!-- Recent projects : separate highlighted block, updated only after a launch -->
                            <Border
                                    Background="{DynamicResource RecentBgBrush}"
                                    BorderBrush="{DynamicResource RecentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,6"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding HasRecentProjects, Converter={StaticResource BooleanToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="🕘 Récemment lancés"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               Margin="4,0,0,4"/>
                                    <ListBox Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding RecentProjects}"
                                             SelectedItem="{Binding SelectedRecentProject, Mode=TwoWay}"
                                             ItemContainerStyle="{StaticResource ProjectListItemWithMenu}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name, StringFormat='🕘  {0}'}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- All projects -->
                        <TextBlock Grid.Row="3"
                                   Text="📁 Tous les projets"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="4,0,0,4"/>
                        <ListBox x:Name="ProjectListBox"
                                 Grid.Row="4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding VisibleProjects}"
                                 SelectedItem="{Binding SelectedProjectEntry, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 ToolTip="Clic droit sur un projet : favoris, Explorateur, chemin, URL locale, contexte pour l'IA"
                                 ItemContainerStyle="{StaticResource ProjectListItemWithMenu}"
                                 SelectionChanged="ProjectListBox_SelectionChanged"/>

                        <!-- Current project : path, git state and quick actions -->
                        <Border Grid.Row="5"
                                Background="{DynamicResource InputBgBrush}" CornerRadius="6"
                                Padding="10,6" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentProjectDisplayPath}"
                                           FontSize="11" FontFamily="Consolas"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Grid Margin="0,6,0,0"
                                      Visibility="{Binding HasGitStatus, Converter={StaticResource BooleanToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding GitStatusText}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentGreenBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="1"
                                            Content="⟳ git fetch"
                                            Style="{StaticResource QuickActionButton}"
                                            Margin="6,0,0,0"
                                            ToolTip="Récupère l'état du dépôt distant pour connaître les commits en retard"
                                            Command="{Binding FetchGitCommand}"/>
                                </Grid>
                                <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding HasProject}">
                                    <Button Content="{Binding FavoriteToggleLabel}"
                                            Style="{StaticResource QuickActionButton}"
                                            ToolTip="{Binding FavoriteToggleToolTip}"
                                            AutomationProperties.Name="Favori"
                                            Command="{Binding ToggleFavoriteCommand}"/>
                                    <Button Content="📂 Explorateur"
                                            Style="{StaticResource QuickActionButton}"
                                            Command="{Binding OpenInExplorerCommand}"/>
                                    <Button Content="📋 Chemin"
                                            Style="{StaticResource QuickActionButton}"
                                            ToolTip="Copier le chemin du projet"
                                            Command="{Binding CopyProjectPathCommand}"/>
                                    <Button Content="🌍 URL locale"
                                            Style="{StaticResource QuickActionButton}"
                                            ToolTip="Ouvrir l'adresse locale du projet"
                                            Command="{Binding OpenLocalUrlCommand}"/>
                                    <Button Content="🧠 Contexte IA"
                                            Style="{StaticResource QuickActionButton}"
                                            ToolTip="Copier la description du projet (stack, arborescence, commandes, URL, git) pour une discussion avec une IA"
                                            Command="{Binding CopyProjectContextCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Right column : options, built from the tool catalog ── -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Card : Project type -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="🏗️ Type de projet" Style="{StaticResource CardTitle}"/>
                                <ComboBox Style="{StaticResource DarkComboBox}"
                                          ItemsSource="{Binding ProjectTypeOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="ProjectType"
                                          SelectedValue="{Binding SelectedProjectType, Mode=TwoWay}"
                                          IsEnabled="{Binding HasProject}"/>
                                <Border Background="{DynamicResource DetectedBgBrush}" CornerRadius="6"
                                        Padding="8,5" Margin="0,8,0,0"
                                        Visibility="{Binding HasDetectedProjectType, Converter={StaticResource BooleanToVisibility}}">
                                    <TextBlock Text="{Binding DetectedProjectTypeText}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentGreenBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Tool cards -->
                        <ItemsControl ItemsSource="{Binding ToolCategoryViewModels}" IsEnabled="{Binding HasProject}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ToolCategoryViewModel}">
                                    <Border Style="{StaticResource CardBorder}"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                            <ItemsControl ItemsSource="{Binding Tools}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewModels:ToolViewModel}">
                                                        <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BooleanToVisibility}}">
                                                            <!-- Exclusive categories use radio buttons, the others check boxes -->
                                                            <CheckBox Content="{Binding Label}"
                                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                      Style="{StaticResource ModernCheckBox}"
                                                                      Visibility="{Binding IsExclusive, Converter={StaticResource InverseBooleanToVisibility}}"/>
                                                            <RadioButton Content="{Binding Label}"
                                                                         IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                         Style="{StaticResource ModernRadioButton}"
                                                                         Visibility="{Binding IsExclusive, Converter={StaticResource BooleanToVisibility}}"/>
                                                            <!-- Options of the enabled tool -->
                                                            <ItemsControl ItemsSource="{Binding Options}"
                                                                          Margin="20,0,0,4"
                                                                          Visibility="{Binding ShowOptions, Converter={StaticResource BooleanToVisibility}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type viewModels:ToolOptionViewModel}">
                                                                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,2">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Label}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                           Margin="0,0,0,6"/>
                                                                                <ComboBox Style="{StaticResource DarkComboBox}"
                                                                                          ItemsSource="{Binding Choices}"
                                                                                          DisplayMemberPath="Label"
                                                                                          SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                                                          Visibility="{Binding IsSingleChoice, Converter={StaticResource BooleanToVisibility}}"/>
                                                                                <ItemsControl ItemsSource="{Binding Choices}"
                                                                                              Visibility="{Binding IsMultipleChoice, Converter={StaticResource BooleanToVisibility}}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="{x:Type viewModels:ToolOptionChoiceViewModel}">
                                                                                            <CheckBox Content="{Binding Label}"
                                                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                                      Style="{StaticResource ModernCheckBox}"/>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                         Background="{DynamicResource CardBgBrush}"
                                                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                         CaretBrush="{DynamicResource AccentBlueBrush}"
                                                                                         BorderBrush="{DynamicResource BorderLineBrush}"
                                                                                         FontFamily="Consolas" FontSize="11" Padding="6,4"
                                                                                         AutomationProperties.Name="{Binding Label}"
                                                                                         Visibility="{Binding IsText, Converter={StaticResource BooleanToVisibility}}"/>
                                                                                <TextBlock Text="Aucun choix disponible (vérifie les paramètres)"
                                                                                           FontSize="11" TextWrapping="Wrap"
                                                                                           Foreground="{DynamicResource AccentRedBrush}"
                                                                                           Visibility="{Binding HasNoChoices, Converter={StaticResource BooleanToVisibility}}"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── Splitter ── -->
            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource SplitterBrush}"
                          Margin="16,0,16,0"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeNS"/>

            <!-- ── Log area : launch log + one tab per service run by DevLauncher ── -->
            <Border Grid.Row="2" Margin="16,0,16,8"
                    Background="{DynamicResource CardBgBrush}"
                    CornerRadius="12" Padding="12,8,12,12">
                <Grid>
                    <TabControl ItemsSource="{Binding LogTabs}"
                                SelectedItem="{Binding SelectedLogTab, Mode=TwoWay}"
                                Style="{StaticResource LogTabControl}"
                                ItemContainerStyle="{StaticResource LogTabItem}">
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:LogTabViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Visibility="{Binding IsService, Converter={StaticResource BooleanToVisibility}}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource AccentRedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentGreenBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Title}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type viewModels:LogTabViewModel}">
                                <DockPanel Margin="0,6,0,0">
                                    <!-- Service actions -->
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding IsService, Converter={StaticResource BooleanToVisibility}}">
                                        <Button Content="⏹ Arrêter"
                                                Style="{StaticResource DangerButton}"
                                                FontSize="10" Padding="8,3" Margin="0,0,6,0"
                                                Command="{Binding StopCommand}"/>
                                        <Button Content="↻ Redémarrer"
                                                Style="{StaticResource PrimaryButton}"
                                                FontSize="10" Padding="8,3" Margin="0,0,6,0"
                                                Command="{Binding RestartCommand}"/>
                                        <Button Content="✖ Fermer l'onglet"
                                                Style="{StaticResource PrimaryButton}"
                                                FontSize="10" Padding="8,3"
                                                ToolTip="Disponible une fois le service arrêté"
                                                Command="{Binding CloseCommand}"/>
                                    </StackPanel>
                                    <!-- Log lines -->
                                    <!-- Search and error filter of the tab -->
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="6" Padding="6,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         CaretBrush="{DynamicResource AccentBlueBrush}"
                                                         FontFamily="Consolas" FontSize="11" Padding="0,4"
                                                         AutomationProperties.Name="Rechercher dans le journal"
                                                         ToolTip="Rechercher dans le journal (Échap pour effacer)">
                                                    <TextBox.InputBindings>
                                                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}"/>
                                                    </TextBox.InputBindings>
                                                </TextBox>
                                            </DockPanel>
                                        </Border>
                                        <CheckBox Grid.Column="1"
                                                  Content="⚠ Erreurs seules"
                                                  IsChecked="{Binding ShowsErrorsOnly, Mode=TwoWay}"
                                                  Style="{StaticResource ModernCheckBox}"
                                                  FontSize="11" Margin="10,0,0,0"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding FilterSummary}"
                                                   FontSize="11" Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentBlueBrush}"
                                                   Visibility="{Binding IsFiltered, Converter={StaticResource BooleanToVisibility}}"/>
                                    </Grid>
                                    <ListBox ItemsSource="{Binding VisibleLines}"
                                             behaviors:ListBoxAutoScroll.IsEnabled="True"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.ScrollUnit="Pixel">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock behaviors:LogLineFormatter.Entry="{Binding}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentRedBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <!-- Copy and clear the selected tab -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button Content="Copier"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="10" Padding="8,3" Margin="0,0,6,0"
                                Command="{Binding CopyLogCommand}"/>
                        <Button Content="Effacer"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="10" Padding="8,3"
                                Command="{Binding ClearLogCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

    </DockPanel>
</Window>
