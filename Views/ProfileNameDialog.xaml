<Window x:Class="DevLauncher.Views.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau profil"
        Width="350"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Nom du profil :"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="13" Margin="0,0,0,8"/>
        <TextBox x:Name="NameBox"
                 Background="{DynamicResource CardBgBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 CaretBrush="{DynamicResource AccentBlueBrush}"
                 BorderBrush="{DynamicResource BorderLineBrush}"
                 FontSize="13" Padding="8,6"/>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Annuler"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="12" Padding="12,6"
                    Margin="0,0,8,0"
                    IsCancel="True"/>
            <Button x:Name="ConfirmButton"
                    Content="Créer"
                    Style="{StaticResource SuccessButton}"
                    FontSize="12" Padding="12,6"
                    IsDefault="True"
                    Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
