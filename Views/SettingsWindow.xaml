<Window x:Class="DevLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevLauncher.Views"
        Title="⚙️ Paramètres"
        Height="780" Width="720"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource DarkBgBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Shared styles of the setting rows -->
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Foreground"    Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"         Value="160"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background"    Value="#1A1A2E"/>
            <Setter Property="Foreground"    Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"   Value="#444466"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontFamily"    Value="Consolas"/>
            <Setter Property="Padding"       Value="8,6"/>
        </Style>
        <Style x:Key="SettingsCaption" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,8,0,3"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content"   Value="📂"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="8,6"/>
            <Setter Property="Margin"    Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource CardBgBrush}"
                Padding="24,16">
            <StackPanel>
                <TextBlock Text="⚙️ Paramètres"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource AccentBlueBrush}"/>
                <TextBlock Text="Configure les chemins et options de DevLauncher"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource CardBgBrush}"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Annuler"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,8" Margin="0,0,8,0"
                            IsCancel="True"/>
                    <Button Content="💾 Sauvegarder"
                            Style="{StaticResource SuccessButton}"
                            Padding="16,8"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- ── Projects ── -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📁 Projets"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Dossiers contenant des projets (un par ligne) : chaque sous-dossier est un projet."
                                   Style="{StaticResource SettingsCaption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProjectRootsBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     AcceptsReturn="True" MinHeight="50"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Style="{StaticResource BrowseButton}"
                                    Content="➕"
                                    ToolTip="Ajouter un dossier"
                                    Click="AddProjectRoot_Click"/>
                        </Grid>
                        <TextBlock Text="Projets ajoutés un par un (un par ligne), situés n'importe où :"
                                   Style="{StaticResource SettingsCaption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExtraProjectsBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     AcceptsReturn="True" MinHeight="50"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Style="{StaticResource BrowseButton}"
                                    Content="➕"
                                    ToolTip="Ajouter un projet"
                                    Click="AddExtraProject_Click"/>
                        </Grid>
                        <TextBlock Text="Dossiers ignorés (séparés par des virgules) :"
                                   Style="{StaticResource SettingsCaption}"/>
                        <TextBox x:Name="ExcludedFoldersBox"
                                 Style="{StaticResource SettingsTextBox}"/>
                    </StackPanel>
                </Border>

                <!-- ── XAMPP ── -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🗄️ XAMPP"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- XamppDir -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dossier XAMPP"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="XamppDirBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="Folder" x:Name="XamppDirBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- Apache -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Apache (httpd.exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="ApacheExeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="ApacheExeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- MySQL exe -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MySQL (mysqld.exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="MySQLExeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="MySQLExeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- MySQL config -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MySQL config (my.ini)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="MySQLConfigBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="MySQLConfigBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- FileZilla -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FileZilla (exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="FileZillaExeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="FileZillaExeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- XAMPP panel -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Panneau XAMPP (exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="XamppPanelBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="XamppPanelBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Mercure ── -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📡 Mercure"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dossier Mercure"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="MercureDirBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="Folder" x:Name="MercureDirBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Editors ── -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="💻 Éditeurs de code"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- VSCode -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VSCode (code ou Code.exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="VSCodeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="VSCodeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- Visual Studio -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Visual Studio"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="VisualStudioBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="VisualStudioBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Browsers ── -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🌍 Navigateurs"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- Chrome -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Google Chrome"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="ChromeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="ChromeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- Firefox -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Firefox"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="FirefoxBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="FirefoxBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Local servers ── -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚡ Serveurs locaux"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port Symfony"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="SymfonyPortBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     MaxLength="5"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port Apache"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="LocalWebPortBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     MaxLength="5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Services ── -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="🧩 Services"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <CheckBox x:Name="HostServicesInVSCodeBox"
                                  Style="{StaticResource ModernCheckBox}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Lancer les services dans les terminaux de VSCode quand VSCode est coché (sinon DevLauncher les lance et affiche leurs journaux)"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ── AI assistants ── -->
                <Border Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="🤖 Assistants IA"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Les assistants cochés apparaissent dans les outils de chaque projet."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="AssistantsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:AssistantSettingsRow}">
                                    <Border Background="#1A1A2E" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox Content="{Binding Label}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      FontWeight="SemiBold"
                                                      Style="{StaticResource ModernCheckBox}"/>
                                            <StackPanel Margin="22,4,0,0"
                                                        IsEnabled="{Binding IsEnabled}">
                                                <CheckBox Content="Ouvrir l'application plutôt que le navigateur par défaut"
                                                          IsChecked="{Binding OpensInApplication, Mode=TwoWay}"
                                                          Style="{StaticResource ModernCheckBox}"/>
                                                <TextBlock Text="Application (exe, raccourci .lnk, protocole ou shell:AppsFolder\…) :"
                                                           Style="{StaticResource SettingsCaption}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding ApplicationTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SettingsTextBox}"/>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource BrowseButton}"
                                                            ToolTip="Choisir l'exécutable ou le raccourci de l'application"
                                                            Click="BrowseAssistantApplication_Click"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ApplicationHint}"
                                                           Style="{StaticResource SettingsCaption}"
                                                           FontStyle="Italic"/>
                                                <TextBlock Text="Page d'une nouvelle discussion :"
                                                           Style="{StaticResource SettingsCaption}"/>
                                                <TextBox Text="{Binding WebUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SettingsTextBox}"/>
                                                <TextBlock Text="Projets ouverts dans le navigateur, un par ligne : Nom | URL (un projet nommé comme le dossier est proposé par défaut)"
                                                           Style="{StaticResource SettingsCaption}"/>
                                                <TextBox Text="{Binding ProjectsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SettingsTextBox}"
                                                         AcceptsReturn="True"
                                                         MinHeight="60"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>