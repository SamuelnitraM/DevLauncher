<Window x:Class="DevLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DevLauncher.Views"
        Title="⚙️ Paramètres"
        Height="780" Width="720"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="Segoe UI"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Shared styles of the setting rows -->
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="13"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"         Value="160"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="Background"    Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource BorderLineBrush}"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontFamily"    Value="Consolas"/>
            <Setter Property="Padding"       Value="8,6"/>
        </Style>
        <Style x:Key="SettingsCaption" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,8,0,3"/>
        </Style>
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Content"   Value="📂"/>
            <Setter Property="FontSize"  Value="11"/>
            <Setter Property="Padding"   Value="8,6"/>
            <Setter Property="Margin"    Value="6,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource CardBgBrush}"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="⚙️ Paramètres"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlueBrush}"/>
                    <TextBlock Text="Configure les chemins et options de DevLauncher"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="ValidationSummaryText"
                               FontSize="11"
                               Foreground="{DynamicResource AccentRedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="AutoDetectButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Content="🔎 Détecter automatiquement"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="12" Padding="12,6"
                        ToolTip="Cherche XAMPP, VSCode, Visual Studio, Chrome et Firefox et remplit les chemins introuvables"
                        Click="AutoDetect_Click"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource CardBgBrush}"
                Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Annuler"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,8" Margin="0,0,8,0"
                            IsCancel="True"/>
                    <Button Content="💾 Sauvegarder"
                            Style="{StaticResource SuccessButton}"
                            Padding="16,8"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- ── Projects ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📁 Projets"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Dossiers contenant des projets (un par ligne) : chaque sous-dossier est un projet."
                                   Style="{StaticResource SettingsCaption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProjectRootsBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     AcceptsReturn="True" MinHeight="50"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Style="{StaticResource BrowseButton}"
                                    Content="➕"
                                    ToolTip="Ajouter un dossier"
                                    Click="AddProjectRoot_Click"/>
                        </Grid>
                        <TextBlock Text="Projets ajoutés un par un (un par ligne), situés n'importe où :"
                                   Style="{StaticResource SettingsCaption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExtraProjectsBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     AcceptsReturn="True" MinHeight="50"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Button Grid.Column="1" VerticalAlignment="Top"
                                    Style="{StaticResource BrowseButton}"
                                    Content="➕"
                                    ToolTip="Ajouter un projet"
                                    Click="AddExtraProject_Click"/>
                        </Grid>
                        <TextBlock Text="Dossiers ignorés (séparés par des virgules) :"
                                   Style="{StaticResource SettingsCaption}"/>
                        <TextBox x:Name="ExcludedFoldersBox"
                                 Style="{StaticResource SettingsTextBox}"/>
                    </StackPanel>
                </Border>

                <!-- ── XAMPP ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🗄️ XAMPP"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- XamppDir -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dossier XAMPP"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="XamppDirBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="Folder" x:Name="XamppDirBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- Apache -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Apache (httpd.exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="ApacheExeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="ApacheExeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- MySQL exe -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MySQL (mysqld.exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="MySQLExeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="MySQLExeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- MySQL config -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MySQL config (my.ini)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="MySQLConfigBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="MySQLConfigBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- FileZilla -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FileZilla (exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="FileZillaExeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="FileZillaExeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- XAMPP panel -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Panneau XAMPP (exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="XamppPanelBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="XamppPanelBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Mercure ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="📡 Mercure"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dossier Mercure"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="MercureDirBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="Folder" x:Name="MercureDirBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Editors ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="💻 Éditeurs de code"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- VSCode -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VSCode (code ou Code.exe)"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="VSCodeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="VSCodeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- Visual Studio -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Visual Studio"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="VisualStudioBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="VisualStudioBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Browsers ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🌍 Navigateurs"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>

                        <!-- Chrome -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Google Chrome"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="ChromeBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="ChromeBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>

                        <!-- Firefox -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Firefox"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="FirefoxBox"
                                     Style="{StaticResource SettingsTextBox}"/>
                            <Button Grid.Column="2" Tag="File" x:Name="FirefoxBtn"
                                    Style="{StaticResource BrowseButton}"
                                    Click="Browse_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Local servers ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="⚡ Serveurs locaux"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port Symfony"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="SymfonyPortBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     MaxLength="5"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port Apache"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox Grid.Column="1" x:Name="LocalWebPortBox"
                                     Style="{StaticResource SettingsTextBox}"
                                     MaxLength="5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Services ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="🧩 Services"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <CheckBox x:Name="HostServicesInVSCodeBox"
                                  Style="{StaticResource ModernCheckBox}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Lancer les services dans les terminaux de VSCode quand VSCode est coché (sinon DevLauncher les lance et affiche leurs journaux)"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ── AI assistants ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="🤖 Assistants IA"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Les assistants cochés apparaissent dans les outils de chaque projet."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="AssistantsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:AssistantSettingsRow}">
                                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox Content="{Binding Label}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      FontWeight="SemiBold"
                                                      Style="{StaticResource ModernCheckBox}"/>
                                            <StackPanel Margin="22,4,0,0"
                                                        IsEnabled="{Binding IsEnabled}">
                                                <CheckBox Content="Ouvrir l'application plutôt que le navigateur par défaut"
                                                          IsChecked="{Binding OpensInApplication, Mode=TwoWay}"
                                                          Style="{StaticResource ModernCheckBox}"/>
                                                <TextBlock Text="Application (exe, raccourci .lnk, protocole ou shell:AppsFolder\…) :"
                                                           Style="{StaticResource SettingsCaption}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding ApplicationTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource SettingsTextBox}"/>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource BrowseButton}"
                                                            ToolTip="Choisir l'exécutable ou le raccourci de l'application"
                                                            Click="BrowseAssistantApplication_Click"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ApplicationHint}"
                                                           Style="{StaticResource SettingsCaption}"
                                                           FontStyle="Italic"/>
                                                <TextBlock Text="Page d'une nouvelle discussion :"
                                                           Style="{StaticResource SettingsCaption}"/>
                                                <TextBox Text="{Binding WebUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SettingsTextBox}"/>
                                                <TextBlock Text="Projets ouverts dans le navigateur, un par ligne : Nom | URL (un projet nommé comme le dossier est proposé par défaut)"
                                                           Style="{StaticResource SettingsCaption}"/>
                                                <TextBox Text="{Binding ProjectsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource SettingsTextBox}"
                                                         AcceptsReturn="True"
                                                         MinHeight="60"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Appearance and background ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="🎨 Apparence et arrière-plan"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Thème"
                                       Style="{StaticResource SettingsLabel}"/>
                            <ComboBox x:Name="ThemeBox" Grid.Column="1"
                                      Style="{StaticResource DarkComboBox}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      AutomationProperties.Name="Thème"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Raccourci global"
                                       Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="GlobalHotkeyBox" Grid.Column="1"
                                     Style="{StaticResource SettingsTextBox}"
                                     AutomationProperties.Name="Raccourci global"/>
                            <TextBlock Grid.Column="2" Margin="10,0,0,0"
                                       Text="Ex. Ctrl+Alt+D, vide pour désactiver : affiche DevLauncher et sa palette depuis n'importe quelle application"
                                       Style="{StaticResource SettingsCaption}"/>
                        </Grid>
                        <CheckBox x:Name="MinimizeToTrayBox"
                                  Style="{StaticResource ModernCheckBox}"
                                  Content="Réduire dans la zone de notification (clic droit sur l'icône : lancer, tout arrêter, quitter)"/>
                        <CheckBox x:Name="ShowNotificationsBox"
                                  Style="{StaticResource ModernCheckBox}"
                                  Content="Notifications Windows : environnement prêt, service arrêté de lui-même"/>
                    </StackPanel>
                </Border>

                <!-- ── Windows integration ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="🪟 Intégration Windows"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Une seule fenêtre DevLauncher : un nouveau démarrage (raccourci, liste de l'icône de la barre des tâches, lien, ligne de commande) est transmis à la fenêtre ouverte."
                                   Style="{StaticResource SettingsCaption}"/>
                        <CheckBox x:Name="StartAtLogonBox"
                                  Style="{StaticResource ModernCheckBox}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Démarrer avec Windows (réduit, avec les droits administrateur, sans confirmation)"/>
                        </CheckBox>
                        <CheckBox x:Name="ShellIntegrationBox"
                                  Style="{StaticResource ModernCheckBox}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Liens devlauncher://launch/projet et entrée « Lancer avec DevLauncher » du clic droit sur un dossier dans l'Explorateur"/>
                        </CheckBox>
                        <TextBlock Text="Ligne de commande : DevLauncher.exe --project nom|chemin [--profile Profil] [--minimized], ou --open pour sélectionner sans lancer."
                                   Style="{StaticResource SettingsCaption}"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- ── Command line agents ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="⌨️ Agents en ligne de commande"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Les agents cochés apparaissent dans les assistants de chaque projet et s'ouvrent dans un onglet de terminal, dans le dossier du projet."
                                   Style="{StaticResource SettingsCaption}"/>
                        <ItemsControl x:Name="CliAgentsItemsControl" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:CliAgentSettingsRow}">
                                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          FontWeight="SemiBold"
                                                          Style="{StaticResource ModernCheckBox}"/>
                                                <TextBlock Text="{Binding InstallationHint}"
                                                           Style="{StaticResource SettingsCaption}"
                                                           Margin="22,0,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="📥 Installer…"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource PrimaryButton}"
                                                    FontSize="11" Padding="10,5"
                                                    ToolTip="{Binding AgentDefinition.InstallUrl}"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource InverseBooleanToVisibility}}"
                                                    Click="InstallCliAgent_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── MCP server ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="🧩 Serveur MCP (DevLauncher pilotable par l'IA)"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Une IA compatible MCP (Claude Code, Claude Desktop…) peut lister les projets, lancer un projet, tout arrêter, lire les journaux des services et les redémarrer. Le serveur n'écoute que sur cet ordinateur."
                                   Style="{StaticResource SettingsCaption}"/>
                        <CheckBox x:Name="McpServerEnabledBox"
                                  Style="{StaticResource ModernCheckBox}"
                                  Content="Activer le serveur MCP local"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Port" Style="{StaticResource SettingsLabel}"/>
                            <TextBox x:Name="McpServerPortBox" Grid.Column="1"
                                     Style="{StaticResource SettingsTextBox}"
                                     MaxLength="5"/>
                        </Grid>
                        <TextBlock Text="Ajout dans Claude Code (le jeton d'accès est propre à cet ordinateur, à ne pas partager) :" Style="{StaticResource SettingsCaption}"/>
                        <TextBox x:Name="McpCommandBox"
                                 Style="{StaticResource SettingsTextBox}"
                                 IsReadOnly="True"/>
                    </StackPanel>
                </Border>

                <!-- ── Administrator rights ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="🛡️ Droits administrateur"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="DevLauncher garde ses droits administrateur. Les applications cochées sont lancées avec les droits de l'utilisateur : glisser-déposer depuis l'Explorateur possible, pas de mention « Administrateur »."
                                   Style="{StaticResource SettingsCaption}"/>
                        <ItemsControl x:Name="UnelevatedFamiliesItemsControl" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type views:UnelevatedFamilyRow}">
                                    <CheckBox Content="{Binding Label}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource ModernCheckBox}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Persistent log ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="📝 Journal"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Le journal de lancement est enregistré chaque jour dans un fichier (10 derniers jours conservés)."
                                   Style="{StaticResource SettingsCaption}"/>
                        <CheckBox x:Name="DetailedLoggingBox"
                                  Style="{StaticResource ModernCheckBox}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Journal détaillé : commandes exécutées, et sortie des services enregistrée dans le fichier"/>
                        </CheckBox>
                        <Button Content="📂 Ouvrir le dossier des journaux"
                                HorizontalAlignment="Left"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11" Padding="10,5" Margin="0,8,0,0"
                                Click="OpenLogsFolder_Click"/>
                    </StackPanel>
                </Border>

                <!-- ── Import / export ── -->
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="12" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="💼 Sauvegarde et changement de machine"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="L'export réunit dans un seul fichier les paramètres enregistrés, les profils de tous les projets, les projets récents et les favoris. L'import remplace les éléments du même nom et garde les autres."
                                   Style="{StaticResource SettingsCaption}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="📤 Exporter…"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="11" Padding="10,5" Margin="0,0,8,0"
                                    Click="Export_Click"/>
                            <Button Content="📥 Importer…"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="11" Padding="10,5"
                                    Click="Import_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>