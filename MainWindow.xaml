<Window x:Class="DevLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dev Launcher"
        Height="680" Width="900"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBgBrush}"
        FontFamily="Segoe UI">

    <DockPanel LastChildFill="True">

        <!-- ═══════════════════ HEADER ═══════════════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBgBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="⚡ Dev Launcher"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource AccentBlueBrush}"/>
                    <TextBlock Text="Lance ton environnement de développement en un clic"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Service indicators + settings button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="12" Padding="10,5" Margin="4,0" Background="#1A3A1A">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ApacheIndicator" Width="8" Height="8"
                             Fill="{StaticResource AccentRedBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Apache" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="10,5" Margin="4,0" Background="#1A3A1A">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MySqlIndicator" Width="8" Height="8"
                             Fill="{StaticResource AccentRedBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="MySQL" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="10,5" Margin="4,0" Background="#1A3A1A">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="FileZillaIndicator" Width="8" Height="8"
                             Fill="{StaticResource AccentRedBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="FileZilla" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Separator -->
                    <Border Width="1" Background="#444466" Margin="8,0"/>

                    <!-- Settings button -->
                    <Button Content="⚙️"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="14" Padding="8,5"
                    ToolTip="Paramètres"
                    Click="Settings_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════ FOOTER / BUTTONS ═══════════════════ -->
        <Border DockPanel.Dock="Bottom"
        Background="{StaticResource CardBgBrush}"
        Padding="24,14" Margin="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Profiles bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- ── Row 1 : Profiles ── -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>    <!-- Label -->
                        <ColumnDefinition Width="200"/>     <!-- Dropdown -->
                        <ColumnDefinition Width="Auto"/>    <!-- Save -->
                        <ColumnDefinition Width="Auto"/>    <!-- Rename -->
                        <ColumnDefinition Width="Auto"/>    <!-- Delete -->
                        <ColumnDefinition Width="*"/>       <!-- Status -->
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                       Text="Profil :"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

                    <!-- Profiles dropdown -->
                    <ComboBox x:Name="ProfileComboBox"
                      Grid.Column="1"
                      Style="{StaticResource DarkComboBox}"
                      IsEnabled="False"
                      SelectionChanged="ProfileComboBox_SelectionChanged"/>

                    <!-- Save button -->
                    <Button Grid.Column="2"
                    x:Name="SaveProfileButton"
                    Content="💾 Sauvegarder"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="11" Padding="10,5"
                    Margin="8,0,0,0"
                    IsEnabled="False"
                    Click="SaveProfile_Click"/>

                    <!-- Rename button -->
                    <Button Grid.Column="3"
                    x:Name="RenameProfileButton"
                    Content="✏️"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="11" Padding="8,5"
                    Margin="6,0,0,0"
                    IsEnabled="False"
                    Click="RenameProfile_Click"/>

                    <!-- Delete button -->
                    <Button Grid.Column="4"
                    x:Name="DeleteProfileButton"
                    Content="🗑️"
                    Style="{StaticResource DangerButton}"
                    FontSize="11" Padding="8,5"
                    Margin="6,0,0,0"
                    IsEnabled="False"
                    Click="DeleteProfile_Click"/>

                    <!-- Status -->
                    <TextBlock Grid.Column="5"
                       x:Name="StatusText"
                       Text="Sélectionne un projet pour commencer"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"/>
                </Grid>

                <!-- ── Row 2 : Action buttons ── -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Stop all button -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="StopAllButton"
                        Content="⏹ Tout arrêter"
                        Style="{StaticResource DangerButton}"
                        Click="StopAll_Click"/>
                    </StackPanel>

                    <!-- Split launch button -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                        <!-- Main launch button -->
                        <Button x:Name="LaunchButton"
                        Content="▶ Lancer l'environnement"
                        Style="{StaticResource SplitSuccessButton}"
                        IsEnabled="False"
                        Click="Launch_Click"/>

                        <!-- Vertical separator -->
                        <Border x:Name="LaunchSplitSeparator"
                        Width="1"
                        Background="#2ABB77"
                        Visibility="Collapsed"/>

                        <!-- Profiles dropdown button -->
                        <Button x:Name="LaunchDropdownButton"
                        Content="▾"
                        Style="{StaticResource SplitSuccessButton}"
                        Tag="0,8,8,0"
                        Padding="10,10"
                        Visibility="Collapsed"
                        Click="LaunchDropdown_Click"/>

                        <!-- Profiles popup -->
                        <Popup x:Name="LaunchProfilesPopup"
                       PlacementTarget="{Binding ElementName=LaunchButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True">
                            <Border Background="#2A2A3E"
                            BorderBrush="#444466"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            MinWidth="220">
                                <StackPanel x:Name="LaunchProfilesPanel"/>
                            </Border>
                        </Popup>

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════ CENTRAL AREA (content + splitter + logs) ═══════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <!-- Content -->
                <RowDefinition Height="6"/>
                <!-- Splitter -->
                <RowDefinition Height="150" MinHeight="60" MaxHeight="400"/>
                <!-- Logs -->
            </Grid.RowDefinitions>

            <!-- ── Main content ── -->
            <Grid Grid.Row="0" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left column : projects list ── -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBgBrush}"
                        CornerRadius="12" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title + refresh button -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📁 Projets XAMPP"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Grid.Column="1" Content="↻ Rafraîchir"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="11" Padding="10,5"
                                    Click="RefreshProjects_Click"/>
                        </Grid>

                        <!-- Search bar -->
                        <Border Grid.Row="1"
                                Background="#1A1A2E" CornerRadius="6"
                                Margin="0,0,0,10" Padding="8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔍" VerticalAlignment="Center"
                                           Margin="0,0,8,0" FontSize="13"/>
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource AccentBlueBrush}"
                                         FontSize="13" Padding="0,8"
                                         TextChanged="SearchBox_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Resources>
                                                <VisualBrush x:Key="HintBrush" TileMode="None"
                                                             Opacity="0.4" Stretch="None"
                                                             AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Rechercher un projet..."
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   FontSize="13"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background" Value="{StaticResource HintBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- Projects list -->
                        <ListBox x:Name="ProjectListBox"
                                 Grid.Row="2"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 DisplayMemberPath="Name"
                                 ItemContainerStyle="{StaticResource ProjectListItem}"
                                 SelectionChanged="ProjectListBox_SelectionChanged">
                            <!-- Section headers : recent projects, then all projects -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="4,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                        </ListBox>

                        <!-- Selected project path -->
                        <Border Grid.Row="3"
                                Background="#1A1A2E" CornerRadius="6"
                                Padding="10,6" Margin="0,10,0,0">
                            <TextBlock x:Name="SelectedPathText"
                                       Text="Aucun projet sélectionné"
                                       FontSize="11" FontFamily="Consolas"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── Right column : options ── -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Card : Project type -->
                        <Border Background="{StaticResource CardBgBrush}"
                                CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🏗️ Type de projet"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,12"/>
                                <RadioButton x:Name="RadioSymfony"
                                             Content="⚡ Symfony"
                                             GroupName="ProjectType"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="13" Cursor="Hand"
                                             Checked="ProjectType_Changed"
                                             Margin="0,4"/>
                                <RadioButton x:Name="RadioOther"
                                             Content="📦 Autre (PHP / HTML…)"
                                             GroupName="ProjectType"
                                             IsChecked="True"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="13" Cursor="Hand"
                                             Checked="ProjectType_Changed"
                                             Margin="0,4"/>
                                <Border x:Name="AutoDetectBadge"
                                        Background="#2A4A2A" CornerRadius="6"
                                        Padding="8,5" Margin="0,8,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="AutoDetectText"
                                               Text="✅ Symfony détecté automatiquement"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentGreenBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card : Symfony services -->
                        <Border x:Name="SymfonyOptionsCard"
                                Background="{StaticResource CardBgBrush}"
                                CornerRadius="12" Padding="16" Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="🔧 Services Symfony"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkSymfonyServer"
                                          Content="🚀 Symfony Server"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"/>
                                <CheckBox x:Name="ChkTailwind"
                                          Content="🎨 Tailwind Watch"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"/>
                                <CheckBox x:Name="ChkMercure"
                                          Content="📡 Mercure"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="ChkMercure_Changed"
                                          Unchecked="ChkMercure_Changed"/>
                                <Border x:Name="MercurePanel"
                                        Background="#1A1A2E" CornerRadius="6"
                                        Padding="10,8" Margin="16,4,0,4"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Script Mercure :"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,6"/>
                                        <ComboBox x:Name="MercureScriptCombo"
                                                  Style="{StaticResource DarkComboBox}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card : XAMPP services -->
                        <Border Background="{StaticResource CardBgBrush}"
                                CornerRadius="12" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="🗄️ Services XAMPP"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,12"/>
                                <CheckBox x:Name="ChkXamppPanel"
                                          Content="🖥️ Panneau XAMPP"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"/>
                                <StackPanel Margin="16,0,0,0">
                                    <CheckBox x:Name="ChkApache"
                                          Content="🌐 Apache"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"/>
                                    <CheckBox x:Name="ChkMySQL"
                                          Content="🗃️ MySQL"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"/>
                                    <CheckBox x:Name="ChkFileZilla"
                                          Content="📂 FileZilla FTP"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card : Tools -->
                        <Border Background="{StaticResource CardBgBrush}"
                                CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🛠️ Outils"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Margin="0,0,0,12"/>
                                <TextBlock Text="Éditeur de code"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,2"/>
                                <RadioButton x:Name="RadioNoEditor"
                                             Content="🚫 Aucun éditeur"
                                             GroupName="Editor"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="13" Cursor="Hand"
                                             Margin="16,2"/>
                                <RadioButton x:Name="RadioVSCode"
                                             Content="💻 VSCode"
                                             GroupName="Editor"
                                             IsChecked="True"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="13" Cursor="Hand"
                                             Margin="16,2"/>
                                <RadioButton x:Name="RadioVisualStudio"
                                             Content="💻 Visual Studio"
                                             GroupName="Editor"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             FontSize="13" Cursor="Hand"
                                             Margin="16,2"/>

                                <CheckBox x:Name="ChkBrowser"
                                          Content="🌍 Ouvrir le navigateur"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="ChkBrowser_Changed"
                                          Unchecked="ChkBrowser_Changed"/>

                                <!-- Browser choice (visible when checked) -->
                                <Border x:Name="BrowserPanel"
                                        Margin="16,0,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkBrowserDefault"
                                                  Content="🌐 Défaut"
                                                  Style="{StaticResource ModernCheckBox}"
                                                  IsChecked="True"/>
                                        <CheckBox x:Name="ChkBrowserChrome"
                                                  Content="🟡 Google Chrome"
                                                  Style="{StaticResource ModernCheckBox}"/>
                                        <CheckBox x:Name="ChkBrowserFirefox"
                                                  Content="🦊 Firefox"
                                                  Style="{StaticResource ModernCheckBox}"/>
                                    </StackPanel>
                                </Border>
                                <CheckBox x:Name="ChkTerminal"
                                          Content="🖥️ Ouvrir un terminal"
                                          Style="{StaticResource ModernCheckBox}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── Splitter ── -->
            <GridSplitter Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#333355"
                          Margin="16,0,16,0"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeNS"/>

            <!-- ── Log area ── -->
            <Border Grid.Row="2" Margin="16,0,16,8"
                    Background="{StaticResource CardBgBrush}"
                    CornerRadius="12" Padding="12">
                <DockPanel>
                    <!-- Fixed header with the clear button -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📋 Journal de lancement"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Grid.Column="1" Content="Effacer"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="10" Padding="8,3"
                    Click="ClearLog_Click"/>
                    </Grid>

                    <!-- Scrollable log area -->
                    <RichTextBox x:Name="LogRichText"
                     FontFamily="Consolas" FontSize="11"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     Padding="0"/>
                </DockPanel>
            </Border>

        </Grid>
        <!-- end of central Grid -->

    </DockPanel>
</Window>
